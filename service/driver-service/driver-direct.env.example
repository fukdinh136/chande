# Backend example for direct Driver + Trip; mobile never receives this file.
# Alternative host placeholders for deployment configuration.
# Set values in a private shell/environment, not in EXPO_PUBLIC variables.
NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://DRIVER_USER:REPLACE_PASSWORD@127.0.0.1:5432/DRIVER_DATABASE
DATABASE_TIMEOUT_MS=5000
DRIVER_LOCK_WAIT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
DRIVER_STATUS_MODE=intent
AUTH_JWT_ISSUER=http://localhost:3003
AUTH_JWT_AUDIENCES=driver-service,trip-service,realtime-service
AUTH_KEY_ID=driver-local
# Use a stable private key file shared with the trusted JWKS configuration.
# AUTH_SIGNING_KEY_FILE=/absolute/private/path/driver-signing.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_MODE=mock
# Set your own six-digit LOCAL code. Never displayed or logged by the API.
OTP_MOCK_CODE=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER_CONTRACT_CONFIRMED=false
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
TRIP_MODE=real
# Trip origin as reached by the backend PC, no /api/v1 unless the real deployment uses it.
TRIP_BASE_URL=http://YOUR_TRIP_HOST:YOUR_TRIP_PORT
HTTP_TIMEOUT_MS=5000
MATCHING_INBOUND_TOKEN=REPLACE_PRIVATE_MATCHING_CREDENTIAL
# Same as Realtime DRIVER_ELIGIBILITY_TOKEN, separate from Matching; at least 32 characters.
REALTIME_INBOUND_TOKEN=
SUPPORTED_VEHICLE_TYPES=BIKE,CAR_4,CAR_7
MAX_VEHICLES=20
GATEWAY_PROXY_TOKEN=
