NODE_ENV=development
PORT=3003
# Existing Driver database only; no schema creation or seed commands.
DATABASE_URL=postgresql://DRIVER_USER:REPLACE_PASSWORD@127.0.0.1:5432/DRIVER_DATABASE
DATABASE_TIMEOUT_MS=5000
# Bounded cross-process advisory-lock acquisition; local FIFO precedes it.
DRIVER_LOCK_WAIT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
DRIVER_STATUS_MODE=intent
AUTH_JWT_ISSUER=http://localhost:3003
AUTH_JWT_AUDIENCES=driver-service,trip-service,realtime-service,matching-service
AUTH_KEY_ID=driver-local
# AUTH_SIGNING_KEY_FILE=/absolute/private/path/driver-signing.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_MODE=mock
# Set your own six-digit local code; never returned or logged.
OTP_MOCK_CODE=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Proposed provider contract requires explicit confirmation.
OTP_PROVIDER_CONTRACT_CONFIRMED=false
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
TRIP_MODE=real
TRIP_BASE_URL=http://127.0.0.1:3001
HTTP_TIMEOUT_MS=5000
MATCHING_INBOUND_TOKEN=REPLACE_PRIVATE_MATCHING_CREDENTIAL
# Optional until Realtime is enabled. Same as Realtime DRIVER_ELIGIBILITY_TOKEN;
# a separate server-only credential, at least 32 characters, never the Matching token.
REALTIME_INBOUND_TOKEN=
SUPPORTED_VEHICLE_TYPES=BIKE,CAR_4,CAR_7
MAX_VEHICLES=20

# Optional credential for a trusted official proxy; leave empty for direct HTTP.
GATEWAY_PROXY_TOKEN=
# Enable all three for authoritative availability reconciliation (separate credentials).
MATCHING_BASE_URL=
TRIP_LOOKUP_TOKEN=
MATCHING_LOOKUP_TOKEN=
