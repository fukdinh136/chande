{
  "name": "driver-service",
  "version": "1.0.0",
  "description": "Driver microservice for Ride-Hailing Platform",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint src",
    "test": "node --require ts-node/register --test test/unit/*.test.cjs test/contract/*.test.cjs test/e2e/*.test.cjs",
    "check:architecture": "node scripts/check-architecture.cjs",
    "check:schema": "node scripts/check-schema.cjs",
    "test:unit": "node --require ts-node/register --test test/unit/*.test.cjs",
    "test:contract": "node --require ts-node/register --test test/contract/*.test.cjs",
    "test:integration": "node --require ts-node/register --test test/integration/*.test.cjs",
    "test:e2e": "node --require ts-node/register --test test/e2e/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  }
}
