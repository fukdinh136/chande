{
  "name": "@chande/trip-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts",
    "test:build": "node scripts/clean-test.cjs && tsc -p tsconfig.test.json",
    "test": "npm run test:build && node scripts/test.cjs unit",
    "test:integration": "npm run test:build && node scripts/test.cjs integration",
    "test:contract": "npm run test:build && node scripts/test.cjs contract",
    "test:e2e": "npm run test:build && node scripts/test.cjs e2e",
    "test:all": "npm run test:build && node scripts/test.cjs all",
    "test:services": "npm --prefix ../routing-service run build && npm --prefix ../price-service run build && npm run test:build && node scripts/test.cjs cross-service",
    "start:dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "start:prod": "node dist/main.js",
    "worker:prod": "node dist/worker.js",
    "outbox:requeue": "node dist/requeue.js",
    "mock:dev": "tsx watch src/mock.ts",
    "mock:prod": "node dist/mock.js",
    "smoke:local": "node scripts/smoke.cjs",
    "migration:run": "node dist/migrate.js",
    "migration:show": "node node_modules/typeorm/cli.js migration:show -d dist/infrastructure/persistence/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
