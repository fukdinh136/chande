{
  "compilerOptions": {
    "target": "ES2023", "module": "Node16", "moduleResolution": "Node16",
    "rootDir": "src", "outDir": "dist", "strict": true,
    "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
