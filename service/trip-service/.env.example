# Development credentials only. Production uses *_FILE secrets.
NODE_ENV=development
INTEGRATION_MODE=mock
PORT=3001
WORKER_HEALTH_PORT=3002
DATABASE_URL=postgres://trip_local:trip_local@127.0.0.1:55433/trip_local
SUPPORTED_VEHICLE_TYPES=MOCK_BIKE
AUTH_JWKS_URL=http://127.0.0.1:3003/jwks
AUTH_JWT_ISSUER=chande-local
AUTH_JWT_AUDIENCE=trip-service
CURSOR_SIGNING_KEY=local-only-cursor-key-change-in-production
MATCHING_CALLBACK_TOKEN=local-callback
ROUTING_BASE_URL=http://127.0.0.1:3003
PRICING_BASE_URL=http://127.0.0.1:3003
MATCHING_BASE_URL=http://127.0.0.1:3003
GATEWAY_EVENTS_BASE_URL=http://127.0.0.1:3003
NOTIFICATION_BASE_URL=http://127.0.0.1:3003
ROUTING_TOKEN=local-routing
PRICING_TOKEN=local-pricing
MATCHING_TOKEN=local-matching
GATEWAY_EVENTS_TOKEN=local-gateway
NOTIFICATION_TOKEN=local-notification
SWAGGER_ENABLED=true
DB_POOL_SIZE=5
HTTP_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_CONCURRENCY=5
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000
WORKER_HEARTBEAT_MAX_AGE_MS=30000
# For tests, set TEST_DATABASE_URL to a database ending in _test.
# Default tests use postgres://trip_test:trip_test@127.0.0.1:55432/trip_test.
