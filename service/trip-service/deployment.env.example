# Copy to deployment.env and replace placeholders. Credentials go in secrets files.
TRIP_IMAGE=registry.example/chande/trip-service@sha256:REPLACE_WITH_RELEASE_DIGEST
TRIP_SECRETS_DIR=./secrets
TRIP_BACKEND_NETWORK=chande-backend
SUPPORTED_VEHICLE_TYPES=REPLACE_WITH_AGREED_VEHICLE_CODES
AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
AUTH_JWT_ISSUER=https://identity.example
AUTH_JWT_AUDIENCE=trip-service
ROUTING_BASE_URL=http://routing:3000
PRICING_BASE_URL=http://pricing:3000
MATCHING_BASE_URL=http://matching:3000
GATEWAY_EVENTS_BASE_URL=http://gateway:3000
NOTIFICATION_BASE_URL=http://notification:3000
