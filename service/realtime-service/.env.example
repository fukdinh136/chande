NODE_ENV=development
PORT=3004
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_TIMEOUT_MS=3000
AUTH_JWKS_URL=http://127.0.0.1:3003/.well-known/jwks.json
AUTH_JWT_ISSUER=http://localhost:3003
AUTH_JWT_AUDIENCE=realtime-service
AUTH_JWKS_TIMEOUT_MS=3000
# Two DIFFERENT credentials. Keep these on servers, never EXPO_PUBLIC_*.
ROUTING_INBOUND_TOKEN=REPLACE_WITH_ROUTING_CREDENTIAL_AT_LEAST_32_CHARACTERS
DRIVER_ELIGIBILITY_TOKEN=REPLACE_WITH_DRIVER_CREDENTIAL_AT_LEAST_32_CHARACTERS
DRIVER_BASE_URL=http://127.0.0.1:3003
DRIVER_TIMEOUT_MS=3000
LOCATION_FRESHNESS_MS=30000
LOCATION_MAX_FUTURE_MS=5000
LOCATION_MAX_ACCURACY_METERS=100
LOCATION_MIN_UPDATE_INTERVAL_MS=1000
LOCATION_ORDER_RETENTION_MS=86400000
CLEANUP_INTERVAL_MS=10000
CLEANUP_BATCH_SIZE=500
NEARBY_MAX_CANDIDATES=5000
SOCKET_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
