{
  "name": "@chande/realtime-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.cjs",
    "start:dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
