# Separate env example for Routing source against Hanoi OSRM.
# Copy to ignored .env.osrm.local, set tokens and supply via node --env-file.
APP_ENV=development
HOST=127.0.0.1
PORT=3004
INTEGRATION_MODE=real
EXTERNAL_MAP_PROVIDER=osrm
EXTERNAL_MAP_BASE_URL=http://127.0.0.1:5000
EXTERNAL_MAP_ALLOWED_HOSTS=127.0.0.1,localhost,osrm
EXTERNAL_MAP_ALLOW_HTTP=true
EXTERNAL_MAP_AUTH_MODE=none
SUPPORTED_VEHICLE_TYPES=CAR
VEHICLE_PROFILES_FILE=config/vehicle-profiles.osrm.json
REALTIME_INTEGRATION_MODE=mock
ROUTING_TRIP_TOKEN=
ROUTING_MATCHING_TOKEN=
ROUTING_GATEWAY_TOKEN=
