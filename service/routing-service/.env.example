# DESIGN TEMPLATE — the Routing application/config loader is not implemented yet.
# Local .env is ignored by Git. Never place real credentials in this example.
APP_ENV=development
HOST=127.0.0.1
PORT=3004
INTEGRATION_MODE=mock
LOG_LEVEL=INFO

# OSRM selected; its adapter is planned, not implemented yet.
EXTERNAL_MAP_PROVIDER=osrm
# Native/self-hosted OSRM needs no API key. Fill only for an authenticated proxy.
EXTERNAL_MAP_API_KEY=
# Production: use a mounted secret instead; do not set both KEY and KEY_FILE.
EXTERNAL_MAP_API_KEY_FILE=
# none for native OSRM; header for a proxy with a documented key header.
EXTERNAL_MAP_AUTH_MODE=none
EXTERNAL_MAP_API_KEY_HEADER=X-API-Key
# Fill your OSRM endpoint here; no public demo endpoint is selected by default.
# Do not add a key, query string, credentials, or operation path to this URL.
EXTERNAL_MAP_BASE_URL=
EXTERNAL_MAP_ALLOWED_HOSTS=127.0.0.1,localhost,osrm
# Enable only for trusted local/private OSRM; never send keys over HTTP.
EXTERNAL_MAP_ALLOW_HTTP=false

# Routing-owned Realtime Client: nearby driver locations only; runtime planned in F11.
# Separate from OSRM mode/credentials. Fill from the Realtime service contract.
REALTIME_INTEGRATION_MODE=mock
REALTIME_BASE_URL=
REALTIME_TOKEN=
REALTIME_TOKEN_FILE=
REALTIME_TIMEOUT_MS=1000
REALTIME_MAX_RESPONSE_BYTES=1048576
NEARBY_DRIVER_RADIUS_METERS=2000

# Separate credentials for callers. Trip must use the same value as ROUTING_TOKEN.
ROUTING_TRIP_TOKEN=
ROUTING_TRIP_TOKEN_FILE=
ROUTING_MATCHING_TOKEN=
ROUTING_MATCHING_TOKEN_FILE=
ROUTING_GATEWAY_TOKEN=
ROUTING_GATEWAY_TOKEN_FILE=

# Vehicle codes are project codes, never assume they equal provider travel modes.
SUPPORTED_VEHICLE_TYPES=MOCK_BIKE
VEHICLE_PROFILES_FILE=config/vehicle-profiles.json

# Proposed application capacity limits, NOT limits of the public OSRM demo.
# Trip currently has HTTP_TIMEOUT_MS=5000; Routing must finish before that.
REQUEST_DEADLINE_MS=4000
UPSTREAM_TIMEOUT_MS=1200
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_MS=100
UPSTREAM_MAX_RESPONSE_BYTES=1048576
QUEUE_MAX_SIZE=50
QUEUE_ADMISSION_TIMEOUT_MS=100
ROUTING_JOB_MAX_WAIT_MS=500
WORKER_POOL_SIZE=2
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=2
RATE_LIMIT_WAIT_TIMEOUT_MS=250
RATE_LIMIT_MATRIX_ELEMENTS_PER_MINUTE=100
MATRIX_MAX_CANDIDATES=25
MATRIX_BATCH_MAX_ELEMENTS=25
SHUTDOWN_GRACE_MS=5000
