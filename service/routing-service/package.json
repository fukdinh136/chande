{
  "name": "@chande/routing-service",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts",
    "test:build": "node scripts/clean-test.cjs && tsc -p tsconfig.test.json",
    "test": "npm run test:build && node scripts/test.cjs unit",
    "test:contract": "npm run test:build && node scripts/test.cjs contract",
    "test:integration": "npm run test:build && node scripts/test.cjs integration",
    "test:e2e": "npm run test:build && node scripts/test.cjs e2e",
    "test:all": "npm run test:build && node scripts/test.cjs all",
    "test:trip": "npm --prefix ../trip-service run build && npm run test:build && node scripts/test.cjs cross-service",
    "smoke:docker": "node scripts/docker-smoke.cjs",
    "osrm:prepare": "node scripts/prepare-osrm.cjs",
    "osrm:up": "docker compose -f osrm/compose.yml up -d --build --wait",
    "smoke:osrm": "node scripts/osrm-smoke.cjs",
    "docs:check": "node scripts/check-docs.cjs",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7", "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7", "@nestjs/swagger": "11.4.7",
    "dotenv": "18.0.5", "reflect-metadata": "0.2.2", "rxjs": "7.8.2", "zod": "4.6.5"
  },
  "overrides": { "@nestjs/swagger": { "js-yaml": "5.4.2" } },
  "devDependencies": {
    "@types/express": "5.0.6", "@types/node": "24.19.1",
    "eslint": "9.39.5", "tsx": "4.23.15", "typescript": "5.9.3", "typescript-eslint": "8.71.0"
  }
}
