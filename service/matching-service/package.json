{
  "name": "@chande/matching-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/integration/*.test.js",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "worker:prod": "node dist/worker.js",
    "migration:run": "node dist/migrate.js",
    "smoke:local": "node scripts/smoke.cjs",
    "outbox:requeue": "node dist/requeue.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "amqplib": "^0.10.9",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    }
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
