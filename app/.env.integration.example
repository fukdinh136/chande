# Public mobile configuration only. Keep backend service tokens out of this file.
# Android emulator -> host Docker; web/adb reverse -> http://127.0.0.1:18080.
# Kubernetes port-forward can use port 18081. Remove origin for development discovery.
EXPO_PUBLIC_BACKEND_ORIGIN=http://10.0.2.2:18080
# Enables native cleartext only in local demo config; requires CNG prebuild/rebuild.
# Normal production discovery still requires explicit HTTPS.
EXPO_PUBLIC_LOCAL_DEMO=true
# Two app identities share source. Use driver for the Driver dev build/Metro instance.
APP_VARIANT=customer
