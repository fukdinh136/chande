# Copy to .env.local (already ignored by app). All EXPO_PUBLIC values are public.
# Direct Driver origin reachable from the phone, WITHOUT /api/v1 or another path.
# Explicit direct mode ignores Customer's saved Gateway and EXPO_PUBLIC_BACKEND_ORIGIN.
EXPO_PUBLIC_DRIVER_HTTP_MODE=direct
EXPO_PUBLIC_DRIVER_BASE_URL=http://YOUR_PC_LAN_IP:3003
EXPO_PUBLIC_DRIVER_TRIP_BASE_URL=
# Only enable after Trip's owner confirms issuer/JWKS/audience for the Driver JWT.
# Trip must verify Driver's issuer/JWKS and accept audience trip-service, role DRIVER.
EXPO_PUBLIC_DRIVER_TRIP_TRUST_CONFIRMED=false
EXPO_PUBLIC_DRIVER_HTTP_TIMEOUT_MS=10000
EXPO_PUBLIC_DRIVER_TRIP_POLL_MS=15000

# Public Matching API: Driver JWT, audience matching-service. No internal token.
# Direct service: no prefix. For a public ingress set its prefix explicitly (e.g. /api/v1).
# In gateway mode, leaving BASE_URL empty uses the confirmed Gateway + its prefix.
EXPO_PUBLIC_DRIVER_MATCHING_BASE_URL=
EXPO_PUBLIC_DRIVER_MATCHING_PREFIX=

# Optional public Gateway for navigation while Driver HTTP stays direct.
# Direct Routing is NOT supported: it requires an internal X-Service-Token.
# Requires GATEWAY_CONTRACT_CONFIRMED=true; uses GATEWAY_PREFIX below.
EXPO_PUBLIC_DRIVER_ROUTING_GATEWAY_BASE_URL=
# Optional Trip notification Gateway origin (/ws), also requiring Trip trust + Gateway confirmation.
# Leaving empty in gateway mode uses DRIVER_GATEWAY_BASE_URL. REST polling is independent.
EXPO_PUBLIC_DRIVER_TRIP_EVENTS_BASE_URL=

# Official Gateway only. No dependency on api-gateway demo.
EXPO_PUBLIC_DRIVER_GATEWAY_BASE_URL=
EXPO_PUBLIC_DRIVER_GATEWAY_PREFIX=/api/v1
EXPO_PUBLIC_DRIVER_GATEWAY_CONTRACT_CONFIRMED=false
# Set ONLY if this same ingress proxies /socket.io/ to Realtime's /realtime namespace.
# Otherwise configure EXPO_PUBLIC_DRIVER_REALTIME_BASE_URL in realtime.env.example.
EXPO_PUBLIC_DRIVER_GATEWAY_REALTIME_CONFIRMED=false
# Gateway origin precedence: DRIVER_GATEWAY_BASE_URL > saved ConnectionSettings/BACKEND_ORIGIN.
# With no origin, confirmed gateway mode can discover known local ingress ports in development.
# Trip trust is NEVER inferred from discovery. Optional invalid URLs disable only that capability.
# Gateway origin ending in the configured /api/v1 prefix is normalized; do not repeat the prefix.
# Optional COMPLETE paths (prefix included), after the owner confirms them.
# Keep :id in vehicle/trip templates. Changes to methods/envelopes belong in the central adapters.
EXPO_PUBLIC_DRIVER_GATEWAY_OTP_REQUEST_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_OTP_VERIFY_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_REFRESH_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_LOGOUT_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_PROFILE_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_VEHICLES_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_VEHICLE_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_SELECTION_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_AVAILABILITY_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_ACTIVE_TRIP_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_HISTORY_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_TRIP_DETAIL_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_TRIP_STATUS_PATH=
EXPO_PUBLIC_DRIVER_GATEWAY_TRIP_CANCEL_PATH=
