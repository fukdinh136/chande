# Sao chép các dòng cần dùng vào .env.local (đã gitignore), rồi khởi động lại Expo.
# Mọi giá trị EXPO_PUBLIC_* đều nằm công khai trong app: không đặt khoá dịch vụ ở đây.

# --- App khách: mọi API đi qua API Gateway ---
# Máy thật: IP LAN của máy chạy gateway. Emulator Android: http://10.0.2.2:8080. Web cùng máy: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
EXPO_PUBLIC_API_PREFIX=/api/v1
# WebSocket trạng thái chuyến của gateway; để trống thì app chỉ dùng polling.
EXPO_PUBLIC_API_WS_PATH=/ws
EXPO_PUBLIC_HTTP_TIMEOUT_MS=10000
EXPO_PUBLIC_RIDER_TRIP_POLL_MS=10000
# Mã loại xe gửi Trip R01 để báo giá; phải có profile ở Routing và biểu giá ở Price.
EXPO_PUBLIC_RIDER_VEHICLE_TYPES=BIKE,CAR_4,CAR_7

# --- Bản đồ ---
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Tâm bản đồ mặc định "lng,lat" (Hồ Gươm).
EXPO_PUBLIC_MAP_CENTER=105.8542,21.0285
# Tìm địa điểm bằng Photon (dữ liệu OpenStreetMap). Từ khoá và vị trí gần đúng được gửi tới máy chủ này.
# Máy chủ công khai chỉ dùng thử với lưu lượng nhỏ; để trống để tắt (vẫn chọn được trên bản đồ / địa chỉ đã lưu).
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io

# --- Tuyến đường và dẫn đường (app khách + màn dẫn đường tài xế) ---
# osrm: gọi thẳng OSRM tự host khi phát triển. gateway: routing-service R02/R04 qua gateway (gateway cần nối /routes).
EXPO_PUBLIC_ROUTING_MODE=osrm
EXPO_PUBLIC_OSRM_BASE_URL=http://10.0.2.2:5000
EXPO_PUBLIC_OSRM_PROFILE=driving
# EXPO_PUBLIC_ROUTING_BASE_URL=http://192.168.1.10:8080/api/v1/routing
# Ép loại xe gửi routing-service, ví dụ CAR khi chưa có profile xe máy.
# EXPO_PUBLIC_ROUTING_VEHICLE_TYPE=CAR
EXPO_PUBLIC_ROUTING_TIMEOUT_MS=10000
