# Driver public Socket.IO origin only: no /api/v1, /realtime or /socket.io/ suffix.
# Namespace /realtime, transport path /socket.io/; JWT audience realtime-service.
# GPS and offers share one Driver connection at this origin/namespace in foreground.
# Trip notifications use the separate DRIVER_TRIP_EVENTS_BASE_URL /ws protocol.
# No Routing/Driver service credentials in the mobile app. Release builds require HTTPS.
# Replace the host and use the published Realtime port (deploy/stack.cjs uses 3006 internally).
EXPO_PUBLIC_DRIVER_REALTIME_BASE_URL=https://realtime.example.invalid
# Android emulator may use http://10.0.2.2:<PUBLISHED_REALTIME_PORT> in development.
# A shared Gateway ingress works only if it also proxies Socket.IO to Realtime.
# Alternatively, gateway mode can use DRIVER_GATEWAY_REALTIME_CONFIRMED=true with no explicit URL.
# Public GPS validation limits: match LOCATION_* on the Realtime deployment.
# Defaults below; freshness <= 30000ms, accuracy 1..1000m, future 1..10000ms.
EXPO_PUBLIC_DRIVER_GPS_FRESHNESS_MS=30000
EXPO_PUBLIC_DRIVER_GPS_MAX_ACCURACY_METERS=100
EXPO_PUBLIC_DRIVER_GPS_MAX_FUTURE_MS=5000
